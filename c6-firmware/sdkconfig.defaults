CONFIG_IDF_TARGET="esp32c6"

# Wi-Fi enabled; run on C6's own radio (no coprocessor)
CONFIG_ESP_WIFI_ENABLED=y

# HTTP server + WebSocket
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_LWIP_MAX_SOCKETS=16

# Console over USB-Serial-JTAG so logs show up on U1
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_NONE=n

# Larger flash + custom partition table with storage partition.
# NOTE: the checked-in sdkconfig must NOT contradict this file (it did: 2MB +
# single-app), or a build silently ships without the storage/SPIFFS partition.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# 64KB flash-MMU pages, matching the reference P4 ESP-Hosted C6 build.
# 32KB pages (the stale sdkconfig value) cannot serve the 4MB custom layout.
CONFIG_MMU_PAGE_SIZE_64KB=y

# The wifi bring-up used to run on the IDF-default 3584B main stack; nesting in
# esp_wifi_init/start overflows it silently ~2s into boot — the observed
# "green 2s, then dead" signature. Move the wifi work off main in code AND give
# main slack here.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# This C6 hosts a soft-AP for at most a handful of phones, with the SDIO
# hosted-slave link and an HTTP+WS server all drawing on the same ~512KB.
# The stock wifi buffer budget is sized for a busy STA+AP and over-allocates
# here; trim it so esp_wifi_init never trips over memory.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
