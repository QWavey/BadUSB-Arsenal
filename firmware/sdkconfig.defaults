# ESP32-P4 target
CONFIG_IDF_TARGET="esp32p4"

# Our chip is revision v1.3 — v5.5's default targets v3.x-only variants.
# Opt into the pre-v3 revision family, then pick the v1.x minimum.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# USB Host = HS peripheral (port 0, CH334 hub), TinyUSB device = FS peripheral (port 1).
# In app_main we SWAP the internal FS PHY onto the USJ pins (GPIO24/25 = the core
# Type-C) via LP_SYSTEM_REG_USB_CTRL_REG, so the same port we flash becomes the
# HID keyboard the PC sees. TinyUSB selects the FS controller: 0 = HS, 1 = FS.
CONFIG_TINYUSB_RHPORT_HS=n
CONFIG_TINYUSB_RHPORT_FS=y

# TinyUSB HID class — TWO instances so the composite (keyboard on interface 0,
# mouse on interface 1) can respond to control requests on BOTH interfaces.
# With HID_COUNT=1, Windows' usbccgp fails the whole device with Code 10 /
# STATUS_UNSUCCESSFUL because interface 1 STALLs its control transfers.
CONFIG_TINYUSB_HID_COUNT=2
CONFIG_TINYUSB_HID_BUFSIZE=64

# BadUSB ATTACKMODE STORAGE: expose the P4's on-flash FATFS partition
# to the PC as a USB Mass Storage device alongside the HID composite.
# The whole thing is one TinyUSB composite (HID kbd + HID mouse + MSC)
# so Windows binds all three drivers off the same VID/PID.
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=8192

# We keep TinyUSB task at a decent priority
CONFIG_TINYUSB_TASK_PRIORITY=5

# Flash size for MINI-B (32MB). If your board is MINI-A (N16R32) that's 16MB flash — change to 16MB.
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="32MB"

# Custom partition table (adds a 16MB MSC FAT partition — see partitions.csv).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Wear-leveling for the MSC partition so power-loss + FAT rewrites
# don't shred one sector after 100k cycles.
CONFIG_WL_SECTOR_SIZE_4096=y

# Bigger monitor buffer for HID logs
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# USB Host: enable external hub support (the CH334F on U2/U3)
CONFIG_USB_HOST_HUBS_SUPPORTED=y
CONFIG_USB_HOST_HUB_MULTI_LEVEL=y

# USB spec requires >=100 ms hub port debounce; IDF's default is 250 ms.
# Dropping to 100 ms shaves 150 ms off cold-plug enumeration on healthy
# keyboards without sacrificing spec conformance.
CONFIG_USB_HOST_DEBOUNCE_DELAY_MS=100

# Log level: allow VERBOSE at runtime via esp_log_level_set (compiled-in max)
CONFIG_LOG_MAXIMUM_EQUALS_DEFAULT=n
CONFIG_LOG_MAXIMUM_LEVEL_VERBOSE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# N32R32 variant: enable the 32 MB PSRAM. Adds ~80 mA idle current but
# unlocks a huge working-set for the payload store, the DuckyScript
# interpreter's parse trees, and buffered SDIO / USB transfers. Cache
# defaults are fine for our access patterns.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_200M=y
# Allocate BSS/data > 4 KB from PSRAM so the internal SRAM stays free
# for hot paths (TinyUSB endpoint buffers, USB Host DMA, etc.).
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# Disable Bluetooth stack (not used)
CONFIG_BT_ENABLED=n

# --- USB Device identity (Windows compatibility) ---
# The esp_tinyusb default PID 0x4004 is shared by countless Espressif HID
# examples. Windows caches the USB driver per VID:PID(+serial), so a stale or
# ghost entry for 303A:4004 =P4HIDPT-0001 makes Windows refuse to re-enumerate
# the device ("doesn't show in Device Manager") even though Linux/Android see
# it fine. A custom PID (0x4B44 = "KD", keyboard) + bumped bcdDevice makes
# Windows treat this as a brand-new device and bind it fresh.
CONFIG_TINYUSB_DESC_USE_DEFAULT_PID=n
CONFIG_TINYUSB_DESC_CUSTOM_PID=0x4B44
# bcdDevice is now set in the custom device_desc in main.c (0x0202).
# Kconfig value below is no longer used since device_descriptor != NULL in tcfg.
CONFIG_TINYUSB_DESC_BCD_DEVICE=0x0202
