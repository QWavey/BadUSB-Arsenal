#!/bin/sh
# GhostLink autostart. Installed at /etc/init.d/S99ghost (rw rootfs).
case "$1" in
  start)
    setsid nohup /bin/sh /root/ghostlink/ghostlink.sh > /dev/kmsg 2>&1 </dev/null &
    ;;
  stop)
    for name in ghostlink.sh sniff.py webui.py redirect302.py button.py forwarder.py ghostlink.dnsmasq; do
        for p in $(ps 2>/dev/null | awk -v n="$name" 'index($0, n) && $0!~"awk" {print $1}'); do
            kill "$p" 2>/dev/null
        done
    done
    # The supervisor exits only after its current sleep and removes its pidfile on the way out.
    # Wait for that, or a start right after this stop would find the old pid alive and do nothing.
    i=0
    while [ -f /run/ghostlink.pid ] && [ $i -lt 40 ]; do sleep 1; i=$((i + 1)); done
    ;;
esac
exit 0
